# Server
PORT=3000
MCP_PATH=/mcp

# GitHub (required for api_pr; needs repo write + PR permissions)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# AIQUAA backend (optional; enables api_requisitos remote lookups)
AIQUAA_API_BASE_URL=https://api.example.aiquaa.com
AIQUAA_ACCESS_TOKEN=your-jwt-for-local-development

# CodeGraph (optional; enables structural repo context)
CODEGRAPH_BIN=codegraph
CODEGRAPH_ALLOWED_ROOTS=/workspace/projects

# Engram (optional; enables persistent per-project memory)
ENGRAM_BIN=engram
ENGRAM_PROJECT_PREFIX=aiquaa-
